# Ejemplo de variables de entorno para desarrollo

# API
API_PORT=8000

# PostgreSQL
POSTGRES_DB=killari_db
POSTGRES_USER=killari_user
POSTGRES_PASSWORD=killari_pass

# MongoDB
MONGO_INITDB_DATABASE=killari_docs

# Neo4j (formato: username/password)
NEO4J_AUTH=neo4j/una_contraseña_muy_segura

# URLs de conexión (si tu aplicación las construye desde variables individuales, ignora estas)
DATABASE_URL=postgresql://killari_user:killari_pass@postgres:5432/killari_db
MONGO_URL=mongodb://mongo:27017/killari_docs
NEO4J_URL=neo4j://neo4j:7687

# Nota: Nunca subas tus credenciales reales a un repositorio público. Usa este archivo
# solo como ejemplo y crea un archivo .env en local con valores seguros.
